{
  "permissions": {
    "allow": [
      "Bash(python3 scripts/*)",
      "Bash(python3 -m unittest*)",
      "Bash(python3 contoh/buat_contoh.py)",
      "Bash(ffprobe *)",
      "Bash(ffmpeg *)",
      "Bash(ls *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(./data/mentah/**)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/status.py\" --singkat"}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/penjaga.py\""}
        ]
      }
    ]
  }
}
